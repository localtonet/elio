<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <ApplicationId>sh.elio.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- The terminal engine is built for these three only; a package for any other would start and then fail. -->
    <RuntimeIdentifiers>android-arm64;android-arm;android-x64</RuntimeIdentifiers>
    <NativeOut>$(MSBuildThisFileDirectory)..\..\native\out\</NativeOut>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Android" />
    <!-- Reads the QR code that adds this device to sync. Only the phone needs a reader; drawing one is Elio's own code. -->
    <PackageReference Include="ZXing.Net" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elio.UI\Elio.UI.csproj" />
    <ProjectReference Include="..\Elio.Connections\Elio.Connections.csproj" />
  </ItemGroup>
  <!-- Built by build/native.sh. -->
  <ItemGroup>
    <AndroidNativeLibrary Include="$(NativeOut)android-arm64\lib\libghostty-vt.so" Abi="arm64-v8a" Condition="Exists('$(NativeOut)android-arm64\lib\libghostty-vt.so')" />
    <AndroidNativeLibrary Include="$(NativeOut)android-arm\lib\libghostty-vt.so" Abi="armeabi-v7a" Condition="Exists('$(NativeOut)android-arm\lib\libghostty-vt.so')" />
    <AndroidNativeLibrary Include="$(NativeOut)android-x64\lib\libghostty-vt.so" Abi="x86_64" Condition="Exists('$(NativeOut)android-x64\lib\libghostty-vt.so')" />
  </ItemGroup>
</Project>
