<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Elio.UI.Fonts.%(Filename)%(Extension)" />
    <!-- The same two again for the controls that draw text with Avalonia: the editor and the preview show code, which needs letters of one width. -->
    <AvaloniaResource Include="Fonts\JetBrainsMono-Regular.ttf" />
    <AvaloniaResource Include="Fonts\JetBrainsMono-Bold.ttf" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Elio.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elio.Terminal\Elio.Terminal.csproj" />
    <ProjectReference Include="..\Elio.Connections\Elio.Connections.csproj" />
    <ProjectReference Include="..\Elio.Core\Elio.Core.csproj" />
    <ProjectReference Include="..\Elio.Localtonet\Elio.Localtonet.csproj" />
    <ProjectReference Include="..\Elio.Sync\Elio.Sync.csproj" />
  </ItemGroup>
</Project>
