<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <NativeOut>$(MSBuildThisFileDirectory)..\..\native\out\</NativeOut>
  </PropertyGroup>
  <!-- Built by build/native.sh. -->
  <ItemGroup>
    <None Include="$(NativeOut)win-x64\bin\ghostty-vt.dll" Link="runtimes\win-x64\native\ghostty-vt.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOut)win-x64\bin\ghostty-vt.dll')" />
    <None Include="$(NativeOut)linux-x64\lib\libghostty-vt.so" Link="runtimes\linux-x64\native\libghostty-vt.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOut)linux-x64\lib\libghostty-vt.so')" />
    <None Include="$(NativeOut)linux-arm64\lib\libghostty-vt.so" Link="runtimes\linux-arm64\native\libghostty-vt.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOut)linux-arm64\lib\libghostty-vt.so')" />
    <!-- Built on a Mac by build/native-apple.sh. -->
    <None Include="$(NativeOut)osx-arm64\lib\libghostty-vt.dylib" Link="runtimes\osx-arm64\native\libghostty-vt.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOut)osx-arm64\lib\libghostty-vt.dylib')" />
    <None Include="$(NativeOut)osx-x64\lib\libghostty-vt.dylib" Link="runtimes\osx-x64\native\libghostty-vt.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOut)osx-x64\lib\libghostty-vt.dylib')" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Elio.Core\Elio.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Themes\schemes.txt" />
  </ItemGroup>
</Project>
